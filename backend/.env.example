# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Execution
# Maximum uploaded Python file size in bytes (1 MB)
MAX_UPLOAD_BYTES=1048576
# How long a script may run before it is killed
EXECUTION_TIMEOUT_SECONDS=5
# stdout and stderr beyond this many bytes are dropped
MAX_OUTPUT_BYTES=262144

# Carbon measurement
# Country (ISO 3166-1 alpha-3) whose grid carbon intensity is used for CO2
CODECARBON_COUNTRY_ISO_CODE=IND
# How many times each version is measured when comparing original vs optimized
COMPARISON_RUNS=3

# RAG
# Relative paths are resolved from the backend folder
CHROMA_DB_DIR=chroma_db
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=3

# LLM (auditor and optimizer)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=high
LLM_TIMEOUT_SECONDS=300
