# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Execution
# Maximum uploaded Python file size in bytes (1 MB)
MAX_UPLOAD_BYTES=1048576
# How long a script may run before it is killed
EXECUTION_TIMEOUT_SECONDS=5
# stdout and stderr beyond this many bytes are dropped
MAX_OUTPUT_BYTES=262144

# Sandbox for uploaded code
# docker: each script runs in a fresh locked-down container (recommended)
# subprocess: plain host process, NOT a security sandbox (local development only)
EXECUTION_SANDBOX=docker
DOCKER_IMAGE=python:3.12-slim
DOCKER_MEMORY=512m
DOCKER_CPUS=1
# How long to wait for a container to start (the first start may pull the image)
DOCKER_START_TIMEOUT_SECONDS=60

# Carbon measurement
# Country (ISO 3166-1 alpha-3) whose grid carbon intensity is used for CO2
CODECARBON_COUNTRY_ISO_CODE=IND
# Seconds between CodeCarbon power readings during a run
CODECARBON_MEASURE_POWER_SECS=1
# How many times each version is measured when comparing original vs optimized
COMPARISON_RUNS=3

# RAG over app/knowledge_base/practices.json
RAG_TOP_K=3
# auto: vector search (Sentence Transformers + ChromaDB via LangChain), falling
# back to BM25 keyword search if the model cannot load. Or force: vector | keyword
RAG_BACKEND=auto
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Where ChromaDB stores the embedded practices (rebuilt when they change)
RAG_PERSIST_DIR=.chroma
# Vector results below this cosine similarity are dropped
RAG_MIN_RELEVANCE=0.2

# LLM (auditor and optimizer), served by Groq
GROQ_API_KEY=
# Must support strict JSON schema output: openai/gpt-oss-120b or openai/gpt-oss-20b
LLM_MODEL=openai/gpt-oss-120b
# low | medium | high
LLM_EFFORT=high
LLM_TIMEOUT_SECONDS=300
